# Copy to .env and fill in from your Supabase project (Settings -> API).
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional. Public origin used inside QR codes and share links.
# Defaults to the origin of the incoming request when unset.
PUBLIC_SITE_URL=https://concard.me

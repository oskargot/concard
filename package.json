{
	"name": "concard",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"icons": "node scripts/make-icons.mjs",
		"stickers": "node scripts/bake-stickers.mjs",
		"emoji:fetch": "node scripts/fetch-emoji-art.mjs",
		"db:test": "bash scripts/db-test.sh"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/archivo": "^5.3.0",
		"@fontsource/fredoka": "^5.3.0",
		"@fontsource/space-mono": "^5.3.0",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"@types/qrcode": "^1.5.6",
		"@vite-pwa/sveltekit": "^1.1.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"sharp": "^0.35.4",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.8",
		"workbox-window": "^7.4.1"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.116.0",
		"jsqr": "^1.4.0",
		"qrcode": "^1.5.4"
	},
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22"
	}
